// SevaNest foundation schema.
// Scope: identity, RBAC mechanism, sessions, audit only. Business tables (bookings, payments, verification, ...)
// are added module-by-module once their requirements are frozen.
// Role/permission rows are DATA; the permission matrix is NOT seeded here (open item Q-11).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  // Bare relative imports: Jest (CommonJS) cannot map the \.js\ suffix Prisma otherwise infers from module=nodenext.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// The three user classes in PRD §3. Admin sub-roles (Operations Admin, Super Admin, ...) are Role rows, not enum values.
enum UserType {
  CUSTOMER
  WORKER
  ADMIN
}

/// FRD FM-01: suspended/blocked users cannot log in (FR-SEC-007). Extend when blacklist semantics are defined.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  type         UserType
  mobile       String?    @unique
  email        String?    @unique
  /// Slow hash (argon2/bcrypt) for credential login; null for OTP-only users. Never returned by any API.
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles     UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]

  @@index([type, status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Stable machine code referenced from code/config.
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Dotted code checked by @Permissions('x.y') guards.
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// One row per device session. The refresh token is opaque, stored only as a hash, and rotated on use (BEA p5).
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Append-only (enforced by DB triggers in the foundation migration): actor, role, action, entity, record, timestamp, metadata.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  /// Must never contain secrets or raw identity-document data.
  metadata   Json?
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

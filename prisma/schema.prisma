// SevaNest schema.
// Scope so far: identity, RBAC mechanism, sessions and device tokens, audit, customer profile and addresses,
// worker profile, service categories and areas, worker availability.
// Other business tables (bookings, payments, verification, ...) are added module-by-module once their requirements are frozen.
// Role/permission rows are DATA; the permission matrix is NOT seeded here (open item Q-11).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Bare relative imports: Jest (CommonJS) cannot map the \.js\ suffix Prisma otherwise infers from module=nodenext.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// The three user classes in PRD §3. Admin sub-roles (Operations Admin, Super Admin, ...) are Role rows, not enum values.
enum UserType {
  CUSTOMER
  WORKER
  ADMIN
}

/// FRD FM-01: suspended/blocked users cannot log in (FR-SEC-007). Extend when blacklist semantics are defined.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  type         UserType
  mobile       String?    @unique
  email        String?    @unique
  /// Slow hash (argon2/bcrypt) for credential login; null for OTP-only users. Never returned by any API.
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles     UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]

  deviceTokens              DeviceToken[]
  customerProfile           CustomerProfile?
  workerProfile             WorkerProfile?
  verificationReviews       WorkerVerificationCheck[] @relation("VerificationReviewer")
  verificationEvents        WorkerVerificationEvent[] @relation("VerificationEventActor")
  customerPhotos            CustomerProfilePhoto[]    @relation("CustomerPhotos")
  bookings                  Booking[]                 @relation("BookingCustomer")
  bookingsCancelled         Booking[]                 @relation("BookingCancelledBy")
  bookingEvents             BookingEvent[]            @relation("BookingEventActor")
  payments                  Payment[]                 @relation("PaymentCustomer")
  paymentsRefunded          Payment[]                 @relation("PaymentRefundedBy")
  supportMessages           SupportMessage[]          @relation("SupportMessageAuthor")
  alertsAcknowledged        AdminAlert[]              @relation("AlertAcknowledger")
  alertsResolved            AdminAlert[]              @relation("AlertResolver")
  blocksMade                UserBlock[]               @relation("BlockBlocker")
  blocksReceived            UserBlock[]               @relation("BlockBlocked")
  reportsMade               SafetyReport[]            @relation("ReportReporter")
  reportsAbout              SafetyReport[]            @relation("ReportTarget")
  legalAcceptances          LegalAcceptance[]         @relation("LegalAcceptanceUser")
  deletionRequests          DeletionRequest[]         @relation("DeletionRequestUser")
  paymentExceptionsResolved PaymentException[]        @relation("PaymentExceptionResolvedBy")
  notifications             Notification[]            @relation("NotificationRecipient")
  attendanceRecorded        AttendanceRecord[]        @relation("AttendanceRecorder")
  attendanceEvents          AttendanceEvent[]         @relation("AttendanceEventActor")
  workerPaymentsRecorded    WorkerPaymentReference[]  @relation("WorkerPaymentRecordedBy")
  replacementsRequested     ReplacementRequest[]      @relation("ReplacementRequester")
  replacementsDecided       ReplacementRequest[]      @relation("ReplacementDecider")
  customerNotesAuthored     CustomerNote[]
  ratingsGiven              Rating[]                  @relation("RatingCustomer")
  ratingsModerated          Rating[]                  @relation("RatingModerator")
  ticketsCreated            SupportTicket[]           @relation("TicketCreator")
  ticketsAssigned           SupportTicket[]           @relation("TicketAssignee")
  ticketsClosed             SupportTicket[]           @relation("TicketCloser")
  ticketEvents              SupportTicketEvent[]      @relation("TicketEventActor")
  shortlist                 CustomerShortlistItem[]   @relation("CustomerShortlist")

  @@index([type, status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Stable machine code referenced from code/config.
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Dotted code checked by @Permissions('x.y') guards.
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// One row per device session. The refresh token is opaque, stored only as a hash, and rotated on use (BEA p5).
model Session {
  id                       String    @id @default(uuid(7)) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt               DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Hash of the refresh token that was current before the last rotation. Presenting it again means the token was
  /// replayed or leaked, so the session is revoked. Replaced on every rotation.
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash")
  /// When the refresh token was last rotated (grace window for a retried refresh from the same device).
  rotatedAt                DateTime? @map("rotated_at") @db.Timestamptz(6)
  /// Client-generated install identifier. At most one ACTIVE session exists per (user, device) (partial unique index).
  deviceId                 String?   @map("device_id")
  deviceName               String?   @map("device_name")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken DeviceToken?

  @@index([userId])
  @@index([expiresAt])
  @@index([previousRefreshTokenHash])
  @@map("sessions")
}

enum DevicePlatform {
  ANDROID
  IOS
}

/// Push (FCM) token bound to exactly one session so pushes stop after logout (BEA p5). The row is removed when the
/// session is revoked. The push channel itself belongs to the Notification module.
model DeviceToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  sessionId String         @unique @map("session_id") @db.Uuid
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// Append-only (enforced by DB triggers in the foundation migration): actor, role, action, entity, record, timestamp, metadata.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  /// Must never contain secrets or raw identity-document data.
  metadata   Json?
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

/// FRD FM-02: a profile is PENDING until verified. The rule that promotes PENDING to VERIFIED is an open decision, so
/// only an authorised admin changes it today; every change is audited with before/after state.
enum CustomerVerificationStatus {
  PENDING
  VERIFIED
}

/// Customer domain (SRS 3.2). One profile per customer user. The mobile number is NOT copied here: it stays on `users`
/// (verified by OTP, read-only). Suspension is `users.status`; the profile only carries the verification state.
model CustomerProfile {
  id                   String                     @id @default(uuid(7)) @db.Uuid
  userId               String                     @unique @map("user_id") @db.Uuid
  name                 String
  email                String
  preferredLanguage    String                     @map("preferred_language")
  verificationStatus   CustomerVerificationStatus @default(PENDING) @map("verification_status")
  /// True once an administrator set the status by hand: automatic verification then leaves it alone.
  verificationAdminSet Boolean                    @default(false) @map("verification_admin_set")
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  addresses CustomerAddress[]
  notes     CustomerNote[]

  @@index([verificationStatus, createdAt])
  @@map("customer_profiles")
}

/// Saved addresses (FR-CUS-004/005). Never hard-deleted: later bookings will reference them, so removal = isActive=false.
/// Database-enforced invariants (see migration): at most one default per customer, a default must be active, and
/// latitude/longitude are both set or both null and within range.
model CustomerAddress {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  line       String
  area       String
  city       String
  pincode    String
  /// Optional presentation fields the customer app asked for (label such as Home/Office, second address line, state).
  label      String?
  line2      String?
  state      String?
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([customerId, isActive])
  @@map("customer_addresses")
}

/// Admin operational notes on a customer (FRD FM-02 "Admin can add notes"). Append-only.
model CustomerNote {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  note       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  author   User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

// ---------------------------------------------------------------------------------------------------------------
// Service categories and areas (admin masters, FRD FM-16) - reference data, never hard-coded in application logic.
// ---------------------------------------------------------------------------------------------------------------

/// Stable `code` is the machine key; `name` is unique ignoring case (migration index). Never deleted: disabling hides it
/// from new selections while existing worker associations stay intact.
model ServiceCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workerSkills WorkerSkill[]

  bookings Booking[]

  engagements CategoryEngagement[]

  pricingGuidance PricingGuidance[]

  @@map("service_categories")
}

/// Which engagement types a category offers (PRD 4). A category with NO rows here is unrestricted (nothing is assumed for a category the
/// administrator has not configured).
model CategoryEngagement {
  categoryId String               @map("category_id") @db.Uuid
  engagement EngagementPreference

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, engagement])
  @@map("category_engagements")
}

/// Service area master (FRD FM-16: unique within the city; enabled/disabled). Ownership of config masters is open (Q-14);
/// the table is stable if it moves to the Admin module later.
model ServiceArea {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  city            String
  isEnabled       Boolean  @default(true) @map("is_enabled")
  /// Optional centre and radius, set by an admin, so a map position can be resolved to this area (nearest centre within its radius).
  centerLatitude  Float?   @map("center_latitude")
  centerLongitude Float?   @map("center_longitude")
  radiusMeters    Int?     @map("radius_meters")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workers WorkerPreferredArea[]

  bookings Booking[]

  pricingGuidance PricingGuidance[]

  @@map("service_areas")
}

// ---------------------------------------------------------------------------------------------------------------
// Workers (FRD FM-04 work profile). KYC/documents belong to the future Verification module.
// ---------------------------------------------------------------------------------------------------------------

/// Only two states are stated by FM-04: still being built, and submitted for verification. Verification outcomes are the
/// Verification module's (conflict C-03).
enum WorkerOnboardingStatus {
  DRAFT
  SUBMITTED
}

/// FR-WP-006 (FRD: a single "Select"). Part of the Availability data.
enum EngagementPreference {
  FULL_TIME
  PART_TIME
  LIVE_IN
  /// PRD section 4 / 5.2: daily, hourly, shift and one-time engagements (drivers, babysitters, elderly care, cleaning).
  DAILY
  HOURLY
  SHIFT
  ONE_TIME
}

/// One per worker user. Every field except `name` is nullable because onboarding saves progress step by step; grouped
/// fields (address, emergency contact, previous employer) are all-or-none (migration CHECKs). `profilePhotoRef` is a
/// storage object key set only by the server (no upload integration exists yet) and is never returned by any API.
model WorkerProfile {
  id                     String                 @id @default(uuid(7)) @db.Uuid
  userId                 String                 @unique @map("user_id") @db.Uuid
  name                   String
  onboardingStatus       WorkerOnboardingStatus @default(DRAFT) @map("onboarding_status")
  submittedAt            DateTime?              @map("submitted_at") @db.Timestamptz(6)
  /// Total months. FRD says "whole years/months", so the lossless unit is stored.
  experienceMonths       Int?                   @map("experience_months")
  /// Rupees. The period (monthly/daily/hourly) is not defined by the specs (open decision).
  expectedSalary         Decimal?               @map("expected_salary") @db.Decimal(12, 2)
  /// Language for the worker's notifications and app (PRD 6.2 / NFR-USA-002). Null = platform default.
  preferredLanguage      String?                @map("preferred_language")
  addressLine            String?                @map("address_line")
  addressArea            String?                @map("address_area")
  addressCity            String?                @map("address_city")
  addressPincode         String?                @map("address_pincode")
  emergencyContactName   String?                @map("emergency_contact_name")
  emergencyContactMobile String?                @map("emergency_contact_mobile")
  previousEmployerName   String?                @map("previous_employer_name")
  previousEmployerMobile String?                @map("previous_employer_mobile")
  profilePhotoRef        String?                @map("profile_photo_ref")
  /// Criminal self-declaration (D-87). Null = not answered. true = the worker states they have a criminal record or pending case.
  /// Detail text only when true. The acceptance time is server-stamped each time the worker (re)confirms the declaration.
  criminalRecordDeclared Boolean?               @map("criminal_record_declared")
  criminalRecordDetails  String?                @map("criminal_record_details")
  criminalDeclaredAt     DateTime?              @map("criminal_declared_at") @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  skills             WorkerSkill[]
  languages          WorkerLanguage[]
  preferredAreas     WorkerPreferredArea[]
  timeWindows        WorkerTimeWindow[]
  workPreference     WorkerWorkPreference?
  verificationChecks WorkerVerificationCheck[]
  bookings           Booking[]
  attendance         AttendanceRecord[]
  ratings            Rating[]
  ratingSummary      WorkerRatingSummary?
  profilePhotos      WorkerProfilePhoto[]
  shortlistedBy      CustomerShortlistItem[]
  references         WorkerReference[]

  @@index([onboardingStatus, createdAt])
  paymentReferences WorkerPaymentReference[]
  @@map("worker_profiles")
}

/// Employer / personal references of a worker (PRD 6.1 "previous employer/reference details"). The single previous employer on the
/// profile stays; this list holds further references. Private to the worker and to staff with worker.view (reads audited).
model WorkerReference {
  id           String   @id @default(uuid(7)) @db.Uuid
  workerId     String   @map("worker_id") @db.Uuid
  position     Int      @db.SmallInt
  name         String
  mobile       String
  relationship String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, mobile])
  @@index([workerId, position])
  @@map("worker_references")
}

/// Roles the worker offers (FR-WP-001). The reverse index serves "workers for category X".
model WorkerSkill {
  workerId   String   @map("worker_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  worker   WorkerProfile   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([workerId, categoryId])
  @@index([categoryId])
  @@map("worker_skills")
}

/// Language codes (FR-WP-002). The catalogue is not defined by the specs: format-checked, optional allow-list.
model WorkerLanguage {
  workerId     String @map("worker_id") @db.Uuid
  languageCode String @map("language_code")

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([workerId, languageCode])
  @@map("worker_languages")
}

// ---------------------------------------------------------------------------------------------------------------
// Availability (FR-WP-003/005/006): engagement preference, preferred service areas, time-of-day windows.
// ---------------------------------------------------------------------------------------------------------------

model WorkerWorkPreference {
  workerId             String               @id @map("worker_id") @db.Uuid
  engagementPreference EngagementPreference @map("engagement_preference")
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_work_preferences")
}

/// Preferred work locations (FR-WP-003). The reverse index serves "workers who work in area X".
model WorkerPreferredArea {
  workerId  String   @map("worker_id") @db.Uuid
  areaId    String   @map("area_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  area   ServiceArea   @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@id([workerId, areaId])
  @@index([areaId])
  @@map("worker_preferred_areas")
}

/// Available timings (FR-WP-005): daily time-of-day windows in minutes after local midnight (India, one timezone), as
/// [start, end). The specs mention no weekdays, so none are modelled (open decision). The migration adds CHECKs
/// (0 <= start < end <= 1440) and a GiST exclusion constraint that forbids overlapping windows for one worker.
model WorkerTimeWindow {
  id          String @id @default(uuid(7)) @db.Uuid
  workerId    String @map("worker_id") @db.Uuid
  startMinute Int    @map("start_minute") @db.SmallInt
  endMinute   Int    @map("end_minute") @db.SmallInt

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_time_windows")
}

/// Check types from FRD FM-05 (PROPOSED list, conflict C-03 / Q-04). Mobile OTP is verified by Auth at login and is not a check here.
enum VerificationCheckType {
  IDENTITY
  ADDRESS
  EMERGENCY_CONTACT
  PREVIOUS_EMPLOYMENT
  POLICE_VERIFICATION
  /// Trade / skill certificate and licence: document-evidenced like identity (worker-app audit 2026-10-15, decision D-87).
  SKILL_CERTIFICATE
  LICENSE
}

/// FRD section 5 status model (PROPOSED). "Not Submitted" is the draft state of an existing row; "Recheck Due" is not stored:
/// it is APPROVED with recheck_at reached, derived at read time so no scheduler is needed.
enum VerificationCheckStatus {
  NOT_SUBMITTED
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum VerificationDocumentStatus {
  PENDING_UPLOAD
  UPLOADED
}

/// The set of checks that must all be APPROVED before a worker counts as verified (FRD section 5: "configurable by operations").
/// A row means "required". Empty set = nobody can be verified (fail closed; Q-04 is open, nothing is seeded).
model VerificationRequirement {
  checkType VerificationCheckType @id @map("check_type")
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("verification_requirements")
}

/// One row per worker and check type (current state). Previous attempts stay in worker_verification_events and in the
/// documents of earlier submissions (FM-05: "previous attempts stay in history").
model WorkerVerificationCheck {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  workerId           String                  @map("worker_id") @db.Uuid
  checkType          VerificationCheckType   @map("check_type")
  status             VerificationCheckStatus @default(NOT_SUBMITTED)
  submittedAt        DateTime?               @map("submitted_at") @db.Timestamptz(6)
  reviewedAt         DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  reviewerUserId     String?                 @map("reviewer_user_id") @db.Uuid
  /// When the current reviewer took the check into review (start-review). Null while unassigned.
  claimedAt          DateTime?               @map("claimed_at") @db.Timestamptz(6)
  remarks            String?
  /// Date (India) on which an approval stops counting and a re-check is due. Optional (FM-05).
  recheckAt          DateTime?               @map("recheck_at") @db.Date
  /// The recheck_at value for which the worker was already reminded (one reminder per due date, never repeated by the loop).
  recheckNotifiedFor DateTime?               @map("recheck_notified_for") @db.Date
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  worker    WorkerProfile             @relation(fields: [workerId], references: [id], onDelete: Restrict)
  reviewer  User?                     @relation("VerificationReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  documents VerificationDocument[]
  events    WorkerVerificationEvent[]

  @@unique([workerId, checkType])
  @@index([status, submittedAt])
  @@map("worker_verification_checks")
}

/// Append-only history of every status change with actor and time (FR-VER-010).
model WorkerVerificationEvent {
  id          String                   @id @default(uuid(7)) @db.Uuid
  checkId     String                   @map("check_id") @db.Uuid
  fromStatus  VerificationCheckStatus? @map("from_status")
  toStatus    VerificationCheckStatus  @map("to_status")
  actorUserId String                   @map("actor_user_id") @db.Uuid
  remarks     String?
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  check WorkerVerificationCheck @relation(fields: [checkId], references: [id], onDelete: Restrict)
  actor User                    @relation("VerificationEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([checkId, createdAt])
  @@map("worker_verification_events")
}

/// Document METADATA. The bytes live in private object storage; object_key is internal and never leaves the backend.
model VerificationDocument {
  id            String                     @id @default(uuid(7)) @db.Uuid
  checkId       String                     @map("check_id") @db.Uuid
  objectKey     String                     @unique @map("object_key")
  contentType   String                     @map("content_type")
  sizeBytes     Int                        @map("size_bytes")
  status        VerificationDocumentStatus @default(PENDING_UPLOAD)
  uploadedAt    DateTime?                  @map("uploaded_at") @db.Timestamptz(6)
  /// SHA-256 of the exact bytes the server read at confirmation. Checked again before a reviewer is given a link, so a swap of the
  /// stored object between confirmation and review is detected. The storage ETag is kept only as a secondary signal (not a hash guarantee).
  contentSha256 String?                    @map("content_sha256")
  storageEtag   String?                    @map("storage_etag")
  /// Set when the server deleted the object (failed validation, or an upload that was never confirmed).
  purgedAt      DateTime?                  @map("purged_at") @db.Timestamptz(6)
  rejectionCode String?                    @map("rejection_code")
  /// Set when the document is included in a submission; null = still part of the worker's open draft.
  submittedAt   DateTime?                  @map("submitted_at") @db.Timestamptz(6)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  check WorkerVerificationCheck @relation(fields: [checkId], references: [id], onDelete: Restrict)

  @@index([checkId, createdAt])
  @@map("verification_documents")
}

// ---------------------------------------------------------------------------------------------------------------
// Booking, Payment, Notifications, Attendance, Replacement (Modules 10-14)
// ---------------------------------------------------------------------------------------------------------------

/// FRD section 4 booking state model (PROPOSED; conflict C-02 / Q-05 is open). Booking and engagement are one entity here (Q-15).
enum BookingStatus {
  NEW_REQUEST
  MATCHED
  INTERVIEW_TRIAL_SCHEDULED
  INTERVIEW_TRIAL_COMPLETED
  PENDING_PAYMENT
  CONFIRMED
  ACTIVE
  REPLACEMENT_REQUESTED
  REPLACED
  COMPLETED
  CANCELLED
}

enum ScheduleType {
  INTERVIEW
  TRIAL
}

enum InterviewStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULE_PROPOSED
  DECLINED
  CANCELLED
  COMPLETED
}

/// A customer requirement and, once matched, the worker engaged for it. Timings are minutes after local midnight (India) like Availability.
model Booking {
  id                 String               @id @default(uuid(7)) @db.Uuid
  customerUserId     String               @map("customer_user_id") @db.Uuid
  workerId           String?              @map("worker_id") @db.Uuid
  categoryId         String               @map("category_id") @db.Uuid
  areaId             String               @map("area_id") @db.Uuid
  engagement         EngagementPreference
  fromMinute         Int                  @map("from_minute") @db.SmallInt
  toMinute           Int                  @map("to_minute") @db.SmallInt
  status             BookingStatus        @default(NEW_REQUEST)
  scheduleType       ScheduleType?        @map("schedule_type")
  scheduledAt        DateTime?            @map("scheduled_at") @db.Timestamptz(6)
  outcomeNote        String?              @map("outcome_note")
  startDate          DateTime?            @map("start_date") @db.Date
  cancelReason       String?              @map("cancel_reason")
  cancelledAt        DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId  String?              @map("cancelled_by_user_id") @db.Uuid
  /// Set on a booking created by the Replacement workflow: the booking it replaces.
  replacesBookingId  String?              @unique @map("replaces_booking_id") @db.Uuid
  /// What the customer asked for at request time (PRD 5.2): where, from when, budget, free-text requirement. Budget period is a label only (Q-39).
  addressId          String?              @map("address_id") @db.Uuid
  requestedStartDate DateTime?            @map("requested_start_date") @db.Date
  budgetMinMinor     Int?                 @map("budget_min_minor")
  budgetMaxMinor     Int?                 @map("budget_max_minor")
  budgetPeriod       String?              @map("budget_period")
  requirementNote    String?              @map("requirement_note")
  /// Worker response to a MATCHED opportunity (PRD 6.3 accept/decline). respond_by is set from configuration when matching, null = no deadline.
  workerRespondedAt  DateTime?            @map("worker_responded_at") @db.Timestamptz(6)
  respondBy          DateTime?            @map("respond_by") @db.Timestamptz(6)
  /// A different interview/trial time proposed by the worker, waiting for the customer (state does not change). Cleared when answered.
  proposedSlotAt     DateTime?            @map("proposed_slot_at") @db.Timestamptz(6)
  proposedSlotNote   String?              @map("proposed_slot_note")
  idempotencyKey     String?              @map("idempotency_key")
  requestHash        String?              @map("request_hash")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  address             CustomerAddress?     @relation(fields: [addressId], references: [id], onDelete: Restrict)
  customer            User                 @relation("BookingCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  cancelledBy         User?                @relation("BookingCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  worker              WorkerProfile?       @relation(fields: [workerId], references: [id], onDelete: Restrict)
  category            ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  area                ServiceArea          @relation(fields: [areaId], references: [id], onDelete: Restrict)
  replaces            Booking?             @relation("BookingReplacement", fields: [replacesBookingId], references: [id], onDelete: Restrict)
  replacedBy          Booking?             @relation("BookingReplacement")
  events              BookingEvent[]
  payments            Payment[]
  attendance          AttendanceRecord[]
  replacementRequests ReplacementRequest[] @relation("ReplacementOriginal")
  replacementFor      ReplacementRequest?  @relation("ReplacementNew")
  rating              Rating?
  tickets             SupportTicket[]
  interviews          InterviewTrial[]

  @@unique([customerUserId, idempotencyKey])
  @@index([customerUserId, createdAt])
  @@index([customerUserId, status])
  @@index([workerId, status])
  @@index([status, createdAt])
  @@index([areaId])
  @@index([categoryId])
  @@index([addressId])
  paymentReferences WorkerPaymentReference[]
  @@map("bookings")
}

/// Append-only timeline: every transition with actor and time (FR-BK-007, FRD section 4).
model BookingEvent {
  id          String         @id @default(uuid(7)) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  /// CUSTOMER | WORKER | ADMIN | SYSTEM
  actorKind   String         @map("actor_kind")
  note        String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  actor   User?   @relation("BookingEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

/// C-05: vocabulary follows the architecture document (CREATED/PENDING/SUCCESS/FAILED/REFUND_*) with SUCCEEDED spelled out; confirm with the client.
enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

/// Admin-configured fee (FRD FM-07: from fee configuration, never hard-coded). Empty until an administrator sets it (Q-01).
model FeeConfig {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  amountMinor Int      @map("amount_minor")
  currency    String   @default("INR")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("fee_configs")
}

model Payment {
  id                    String        @id @default(uuid(7)) @db.Uuid
  bookingId             String        @map("booking_id") @db.Uuid
  customerUserId        String        @map("customer_user_id") @db.Uuid
  feeCode               String        @map("fee_code")
  amountMinor           Int           @map("amount_minor")
  currency              String
  status                PaymentStatus @default(CREATED)
  providerOrderId       String?       @unique @map("provider_order_id")
  providerPaymentId     String?       @unique @map("provider_payment_id")
  /// Data the client SDK needs to open the checkout. Public provider data only, never a secret.
  checkoutPayload       Json?         @map("checkout_payload")
  receiptNumber         String?       @unique @map("receipt_number")
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz(6)
  failureReason         String?       @map("failure_reason")
  /// Gateway error code of the last failed attempt (for example BAD_REQUEST_ERROR); null otherwise.
  failureCode           String?       @map("failure_code")
  /// How the customer paid, as the gateway reports it: upi, card, netbanking, wallet, emi. Display only.
  paymentMethod         String?       @map("payment_method")
  /// Masked detail of the method (card network and last 4, masked UPI id, bank or wallet code). Never a full number.
  paymentMethodDetail   String?       @map("payment_method_detail")
  refundReason          String?       @map("refund_reason")
  refundProviderId      String?       @map("refund_provider_id")
  refundedAt            DateTime?     @map("refunded_at") @db.Timestamptz(6)
  refundedByUserId      String?       @map("refunded_by_user_id") @db.Uuid
  /// Recovery bookkeeping (reconciliation sweeper). `reconcileNextAt` set = the payment (or its refund, or the order of a cancelled
  /// booking) is waiting for an authoritative check; null = nothing to check. A worker claims a row by pushing `reconcileClaimedUntil`
  /// into the future, so two workers never process the same payment and a crashed worker's claim simply expires.
  reconcileAttempts     Int           @default(0) @map("reconcile_attempts")
  reconcileNextAt       DateTime?     @map("reconcile_next_at") @db.Timestamptz(6)
  reconcileClaimedUntil DateTime?     @map("reconcile_claimed_until") @db.Timestamptz(6)
  reconcileLastAt       DateTime?     @map("reconcile_last_at") @db.Timestamptz(6)
  /// Stable code of the last check outcome (e.g. NO_GATEWAY_ACTIVITY, PROVIDER_UNAVAILABLE). Never provider payloads.
  reconcileLastNote     String?       @map("reconcile_last_note")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer   User               @relation("PaymentCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  refundedBy User?              @relation("PaymentRefundedBy", fields: [refundedByUserId], references: [id], onDelete: Restrict)
  events     PaymentEvent[]
  exceptions PaymentException[]

  @@index([customerUserId, createdAt])
  @@index([bookingId])
  @@index([status, createdAt])
  @@map("payments")
}

/// One row per provider notification received: duplicate webhooks become harmless and there is a reconciliation trail.
model PaymentEvent {
  id                String   @id @default(uuid(7)) @db.Uuid
  providerEventId   String   @unique @map("provider_event_id")
  paymentId         String?  @map("payment_id") @db.Uuid
  outcome           String
  applied           Boolean
  note              String?
  /// What the notification said, kept so an UNKNOWN_ORDER event can be replayed once the order exists. Gateway ids and amounts only.
  eventKind         String?  @map("event_kind")
  providerOrderId   String?  @map("provider_order_id")
  providerPaymentId String?  @map("provider_payment_id")
  providerRefundId  String?  @map("provider_refund_id")
  amountMinor       Int?     @map("amount_minor")
  currency          String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("payment_events")
}

enum PaymentExceptionKind {
  /// The payment succeeded and the booking was cancelled afterwards (or the reverse order): money is held for a dead booking.
  PAID_BOOKING_CANCELLED
  /// The gateway reported success for a payment whose booking is no longer waiting for payment (cancelled while checkout was open).
  LATE_PAYMENT_BOOKING_NOT_PENDING
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  /// A second successful payment on an order that was already paid (the customer was charged twice).
  DUPLICATE_PAYMENT
  /// A gateway notification for an order we do not know, still unmatched after the replay window.
  UNKNOWN_ORDER_EVENT
  /// The gateway keeps answering with a non-final state or errors; automatic checks stopped.
  RECONCILIATION_EXHAUSTED
  /// A refund request has no final answer after repeated checks.
  REFUND_STUCK
  /// The gateway shows a refund we did not request through the system.
  REFUND_NOT_REQUESTED
}

enum PaymentExceptionStatus {
  OPEN
  RESOLVED
}

/// A money problem that needs a human with payment permission (no policy decides it automatically: refund rules are open, Q-17/Q-21).
/// One OPEN row per (payment, kind) via `dedupeKey`, so a sweeper re-detecting the same problem never creates duplicates.
model PaymentException {
  id                String                 @id @default(uuid(7)) @db.Uuid
  dedupeKey         String                 @unique @map("dedupe_key")
  kind              PaymentExceptionKind
  status            PaymentExceptionStatus @default(OPEN)
  paymentId         String?                @map("payment_id") @db.Uuid
  bookingId         String?                @map("booking_id") @db.Uuid
  bookingStatus     String?                @map("booking_status")
  paymentStatus     String?                @map("payment_status")
  amountMinor       Int?                   @map("amount_minor")
  currency          String?
  providerOrderId   String?                @map("provider_order_id")
  providerPaymentId String?                @map("provider_payment_id")
  requiredAction    String                 @map("required_action")
  details           Json?
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt        DateTime?              @map("resolved_at") @db.Timestamptz(6)
  resolvedByUserId  String?                @map("resolved_by_user_id") @db.Uuid
  resolutionNote    String?                @map("resolution_note")

  payment    Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  resolvedBy User?    @relation("PaymentExceptionResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([paymentId])
  @@index([resolvedByUserId])
  @@map("payment_exceptions")
}

enum NotificationChannel {
  PUSH
  SMS
  WHATSAPP
  /// The user's in-app inbox: the notification row itself is the message (no provider involved).
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/// Transactional outbox: written in the same transaction as the business change, consumed by Notifications.
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  topic         String
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  /// Dispatch failures of THIS event (a malformed payload, a bug): bounded retries with backoff, then dead-lettered (failed_at).
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(6)

  notifications Notification[]

  @@index([processedAt, failedAt])
  @@map("outbox_events")
}

/// Admin-configurable wording and enabled channels per event (FR-NOT-004). Nothing is seeded: wording is not specified.
model NotificationTemplate {
  id            String              @id @default(uuid(7)) @db.Uuid
  eventCode     String              @map("event_code")
  channel       NotificationChannel
  language      String              @default("en")
  title         String?
  body          String
  /// India DLT: the registered template id this SMS wording belongs to (informational; the SMS adapter has its own mapping).
  dltTemplateId String?             @map("dlt_template_id")
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  notifications Notification[]

  @@unique([eventCode, channel, language])
  @@map("notification_templates")
}

/// Channel, template and delivery status per recipient (FR-NOT-005). dedupe_key makes retries and replays harmless.
model Notification {
  id                String              @id @default(uuid(7)) @db.Uuid
  outboxEventId     String              @map("outbox_event_id") @db.Uuid
  recipientUserId   String              @map("recipient_user_id") @db.Uuid
  eventCode         String              @map("event_code")
  channel           NotificationChannel
  templateId        String?             @map("template_id") @db.Uuid
  params            Json
  status            NotificationStatus  @default(QUEUED)
  attempts          Int                 @default(0)
  lastError         String?             @map("last_error")
  providerMessageId String?             @map("provider_message_id")
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(6)
  /// In-app inbox read marker (IN_APP channel only).
  readAt            DateTime?           @map("read_at") @db.Timestamptz(6)
  dedupeKey         String              @unique @map("dedupe_key")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  outboxEvent OutboxEvent           @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)
  recipient   User                  @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  template    NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([outboxEventId])
  @@index([templateId])
  @@index([recipientUserId, channel, readAt])
  @@map("notifications")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCEPTION
  /// Worked, but arrived late (D-76). Counts as a worked day.
  LATE
  /// Approved or announced leave of the worker (D-76). Not a worked day.
  LEAVE
}

/// Who made an entry: a worker, a customer (raising an exception) or an administrator (FRD FM-09).
enum ActorKind {
  WORKER
  CUSTOMER
  ADMIN
}

/// Status-based attendance per booking and date (FR-ATT-001..003). One row per (booking, date); changes live in attendance_events.
model AttendanceRecord {
  id               String           @id @default(uuid(7)) @db.Uuid
  bookingId        String           @map("booking_id") @db.Uuid
  workerId         String           @map("worker_id") @db.Uuid
  date             DateTime         @db.Date
  status           AttendanceStatus
  note             String?
  /// Server-stamped when the worker checks in / out (D-77). Never derived from a status.
  checkInAt        DateTime?        @map("check_in_at") @db.Timestamptz(6)
  checkOutAt       DateTime?        @map("check_out_at") @db.Timestamptz(6)
  recordedByUserId String           @map("recorded_by_user_id") @db.Uuid
  recordedByKind   ActorKind        @map("recorded_by_kind")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking    Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  worker     WorkerProfile     @relation(fields: [workerId], references: [id], onDelete: Restrict)
  recordedBy User              @relation("AttendanceRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  events     AttendanceEvent[]

  @@unique([bookingId, date])
  @@index([workerId, date])
  @@map("attendance_records")
}

/// Append-only: the first entry and every later correction, with actor and reason.
model AttendanceEvent {
  id          String            @id @default(uuid(7)) @db.Uuid
  recordId    String            @map("record_id") @db.Uuid
  fromStatus  AttendanceStatus? @map("from_status")
  toStatus    AttendanceStatus  @map("to_status")
  note        String?
  reason      String?
  actorUserId String            @map("actor_user_id") @db.Uuid
  actorKind   ActorKind         @map("actor_kind")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  record AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  actor  User             @relation("AttendanceEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([recordId, createdAt])
  @@map("attendance_events")
}

enum ReplacementReason {
  WORK_QUALITY
  BEHAVIOUR
  ATTENDANCE
  MISMATCH
  WORKER_UNAVAILABLE
  OTHER
}

enum ReplacementStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

/// FR-REP-001..008: reason, review, approval and the replacement booking. Eligibility beyond "the booking is ACTIVE" is undefined (Q-09).
model ReplacementRequest {
  id                   String            @id @default(uuid(7)) @db.Uuid
  bookingId            String            @map("booking_id") @db.Uuid
  requestedByUserId    String            @map("requested_by_user_id") @db.Uuid
  reason               String
  reasonCode           ReplacementReason @default(OTHER) @map("reason_code")
  notes                String?
  /// Date the customer wants the replacement from (informational: it does not change the booking, price or start rules).
  neededFrom           DateTime?         @map("needed_from") @db.Date
  status               ReplacementStatus @default(REQUESTED)
  decidedByUserId      String?           @map("decided_by_user_id") @db.Uuid
  decidedAt            DateTime?         @map("decided_at") @db.Timestamptz(6)
  /// Internal staff remarks: never shown to customers (Q-110).
  decisionRemarks      String?           @map("decision_remarks")
  /// Customer-facing decision message (Q-110).
  decisionMessage      String?           @map("decision_message")
  replacementBookingId String?           @unique @map("replacement_booking_id") @db.Uuid
  completedAt          DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking            Booking  @relation("ReplacementOriginal", fields: [bookingId], references: [id], onDelete: Restrict)
  replacementBooking Booking? @relation("ReplacementNew", fields: [replacementBookingId], references: [id], onDelete: Restrict)
  requestedBy        User     @relation("ReplacementRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy          User?    @relation("ReplacementDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([requestedByUserId, createdAt])
  @@index([status, createdAt])
  @@map("replacement_requests")
}

enum RatingStatus {
  VISIBLE
  HIDDEN
}

/// FR-RAT-001..004: a customer's rating of the worker of ONE completed booking (at most one per booking). HIDDEN = moderated by an admin (FRD FM-10).
model Rating {
  id                String       @id @default(uuid(7)) @db.Uuid
  bookingId         String       @unique @map("booking_id") @db.Uuid
  customerUserId    String       @map("customer_user_id") @db.Uuid
  workerId          String       @map("worker_id") @db.Uuid
  /// 1..RATING_SCALE_MAX (the upper bound is configuration, Q-58).
  score             Int          @db.SmallInt
  reviewText        String?      @map("review_text")
  /// Codes from the fixed rating tag catalogue (common/rating/rating-tags.ts); empty when none were chosen.
  tags              String[]     @default([])
  status            RatingStatus @default(VISIBLE)
  moderatedByUserId String?      @map("moderated_by_user_id") @db.Uuid
  moderatedAt       DateTime?    @map("moderated_at") @db.Timestamptz(6)
  moderationReason  String?      @map("moderation_reason")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer    User          @relation("RatingCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  worker      WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Restrict)
  moderatedBy User?         @relation("RatingModerator", fields: [moderatedByUserId], references: [id], onDelete: Restrict)

  @@index([workerId, status, createdAt])
  @@index([customerUserId, createdAt])
  @@index([status, createdAt])
  @@map("ratings")
}

/// Maintained atomically with every VISIBLE rating change so profile/report reads never scan ratings (FR-RAT-003).
model WorkerRatingSummary {
  workerId    String   @id @map("worker_id") @db.Uuid
  ratingCount Int      @default(0) @map("rating_count")
  ratingSum   Int      @default(0) @map("rating_sum")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@map("worker_rating_summaries")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  CLOSED
}

/// Values are PROPOSED (Q-59): the specs name a priority but no scale.
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

/// "Category: Select from configured list" (FRD FM-12). Admin data; none seeded.
model SupportCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tickets SupportTicket[]

  @@map("support_categories")
}

/// FR-SUP-001..006: a ticket raised by a customer or a worker, optionally about one of their own bookings.
model SupportTicket {
  id               String          @id @default(uuid(7)) @db.Uuid
  creatorUserId    String          @map("creator_user_id") @db.Uuid
  /// CUSTOMER or WORKER only (CHECK).
  creatorKind      ActorKind       @map("creator_kind")
  bookingId        String?         @map("booking_id") @db.Uuid
  categoryId       String          @map("category_id") @db.Uuid
  /// Optional one-line title the user typed (D-73). Null for tickets raised without one.
  subject          String?
  description      String
  priority         TicketPriority?
  status           TicketStatus    @default(OPEN)
  assignedToUserId String?         @map("assigned_to_user_id") @db.Uuid
  assignedAt       DateTime?       @map("assigned_at") @db.Timestamptz(6)
  escalatedAt      DateTime?       @map("escalated_at") @db.Timestamptz(6)
  resolution       String?
  closedAt         DateTime?       @map("closed_at") @db.Timestamptz(6)
  closedByUserId   String?         @map("closed_by_user_id") @db.Uuid
  /// Resolution target (SLA). Set from configuration only (SUPPORT_SLA_HOURS_*); null = no target configured. Breach is alerted once.
  dueAt            DateTime?       @map("due_at") @db.Timestamptz(6)
  slaBreachedAt    DateTime?       @map("sla_breached_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator    User                 @relation("TicketCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  assignedTo User?                @relation("TicketAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  closedBy   User?                @relation("TicketCloser", fields: [closedByUserId], references: [id], onDelete: Restrict)
  booking    Booking?             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  category   SupportCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  events     SupportTicketEvent[]
  messages   SupportMessage[]

  @@index([dueAt])
  @@index([creatorUserId, createdAt])
  @@index([status, createdAt])
  @@index([assignedToUserId, status])
  @@index([bookingId])
  @@index([categoryId, createdAt])
  @@map("support_tickets")
}

/// Append-only ticket history (trigger). `internalNote` is staff-only and never shown to the ticket creator.
model SupportTicketEvent {
  id           String        @id @default(uuid(7)) @db.Uuid
  ticketId     String        @map("ticket_id") @db.Uuid
  type         String
  fromStatus   TicketStatus? @map("from_status")
  toStatus     TicketStatus? @map("to_status")
  /// Null when the system acted (automatic SLA escalation).
  actorUserId  String?       @map("actor_user_id") @db.Uuid
  internalNote String?       @map("internal_note")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor  User?         @relation("TicketEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("support_ticket_events")
}

enum PhotoStatus {
  PENDING_UPLOAD
  READY
}

/// Worker profile photo uploads (FR-WON-002). Private object; the current photo is the newest READY row.
model WorkerProfilePhoto {
  id             String      @id @default(uuid(7)) @db.Uuid
  workerId       String      @map("worker_id") @db.Uuid
  objectKey      String      @unique @map("object_key")
  contentType    String      @map("content_type")
  sizeBytes      Int         @map("size_bytes")
  status         PhotoStatus @default(PENDING_UPLOAD)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt    DateTime?   @map("confirmed_at") @db.Timestamptz(6)
  /// Server-made WebP renditions (small for cards, large for the profile). Null for photos confirmed before D-69.
  cardObjectKey  String?     @map("card_object_key")
  largeObjectKey String?     @map("large_object_key")

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@index([workerId, status, confirmedAt])
  @@map("worker_profile_photos")
}

/// A customer's own profile photo (customer-app request 8). Private to the customer: no other role is shown it. The newest READY row
/// is current; a replaced photo is removed together with its renditions at confirmation.
model CustomerProfilePhoto {
  id             String      @id @default(uuid(7)) @db.Uuid
  customerUserId String      @map("customer_user_id") @db.Uuid
  objectKey      String      @unique @map("object_key")
  contentType    String      @map("content_type")
  sizeBytes      Int         @map("size_bytes")
  status         PhotoStatus @default(PENDING_UPLOAD)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt    DateTime?   @map("confirmed_at") @db.Timestamptz(6)
  cardObjectKey  String?     @map("card_object_key")
  largeObjectKey String?     @map("large_object_key")

  customer User @relation("CustomerPhotos", fields: [customerUserId], references: [id], onDelete: Restrict)

  @@index([customerUserId, status, confirmedAt])
  @@index([status, createdAt])
  @@map("customer_profile_photos")
}

/// A customer's shortlist / favourites (FR-WD-005). One row per (customer, worker); owned by the customer.
model CustomerShortlistItem {
  customerUserId String   @map("customer_user_id") @db.Uuid
  workerId       String   @map("worker_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer User          @relation("CustomerShortlist", fields: [customerUserId], references: [id], onDelete: Restrict)
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@id([customerUserId, workerId])
  @@index([customerUserId, createdAt])
  @@index([workerId])
  @@map("customer_shortlist_items")
}

/// Conversation on a ticket (customer/worker <-> staff). `isInternal` messages are staff-only and never returned to the creator.
model SupportMessage {
  id           String    @id @default(uuid(7)) @db.Uuid
  ticketId     String    @map("ticket_id") @db.Uuid
  authorUserId String    @map("author_user_id") @db.Uuid
  /// CUSTOMER, WORKER or ADMIN.
  authorKind   ActorKind @map("author_kind")
  body         String
  isInternal   Boolean   @default(false) @map("is_internal")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User          @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorUserId])
  @@map("support_messages")
}

enum AdminAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AdminAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// Operational alert for staff (PRD 13 monitoring/alerts; FRD "admin is alerted"): one open row per (type, entity) via `dedupeKey`;
/// repeats only bump `occurrences`/`lastSeenAt`. Raised by scheduled jobs and by money problems; resolved by a person or automatically.
model AdminAlert {
  id                 String             @id @default(uuid(7)) @db.Uuid
  dedupeKey          String             @unique @map("dedupe_key")
  type               String
  severity           AdminAlertSeverity
  status             AdminAlertStatus   @default(OPEN)
  /// Permission code a viewer needs to see this alert (e.g. payment.view); null = any admin.
  requiredPermission String?            @map("required_permission")
  entityType         String?            @map("entity_type")
  entityId           String?            @map("entity_id")
  title              String
  detail             Json?
  occurrences        Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt         DateTime           @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  acknowledgedAt     DateTime?          @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy     String?            @map("acknowledged_by") @db.Uuid
  resolvedAt         DateTime?          @map("resolved_at") @db.Timestamptz(6)
  resolvedBy         String?            @map("resolved_by") @db.Uuid
  resolutionNote     String?            @map("resolution_note")

  acknowledger User? @relation("AlertAcknowledger", fields: [acknowledgedBy], references: [id], onDelete: Restrict)
  resolver     User? @relation("AlertResolver", fields: [resolvedBy], references: [id], onDelete: Restrict)

  @@index([status, severity, createdAt])
  @@index([entityType, entityId])
  @@index([acknowledgedBy])
  @@index([resolvedBy])
  @@map("admin_alerts")
}

/// Safety: a customer or worker blocks another user. A block hides the pair from each other in search/shortlist/matching and refuses new
/// bookings between them. Created by the user or by staff (`createdByAdmin`). Removal is audited by the service.
model UserBlock {
  id             String   @id @default(uuid(7)) @db.Uuid
  blockerUserId  String   @map("blocker_user_id") @db.Uuid
  blockedUserId  String   @map("blocked_user_id") @db.Uuid
  reason         String?
  createdByAdmin Boolean  @default(false) @map("created_by_admin")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker User @relation("BlockBlocker", fields: [blockerUserId], references: [id], onDelete: Restrict)
  blocked User @relation("BlockBlocked", fields: [blockedUserId], references: [id], onDelete: Restrict)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
  @@map("user_blocks")
}

/// Safety report (PRD 9.1 Report): the reporter's own account about another user and/or one of their bookings. It opens a support
/// ticket for staff; the report row keeps the machine-readable reason.
model SafetyReport {
  id             String   @id @default(uuid(7)) @db.Uuid
  reporterUserId String   @map("reporter_user_id") @db.Uuid
  targetUserId   String   @map("target_user_id") @db.Uuid
  bookingId      String?  @map("booking_id") @db.Uuid
  reasonCode     String   @map("reason_code")
  note           String?
  ticketId       String?  @map("ticket_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reporter User @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  target   User @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([reporterUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("safety_reports")
}

/// Which version of which legal document a user accepted (terms/privacy, PRD 13). Append-only evidence.
model LegalAcceptance {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  documentType String   @map("document_type")
  version      String
  acceptedAt   DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)

  user User @relation("LegalAcceptanceUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, documentType, version])
  @@map("legal_acceptances")
}

enum DeletionRequestStatus {
  REQUESTED
  CANCELLED
  COMPLETED
}

/// A user's request to delete their account and personal data (store policy / privacy law). Nothing is erased automatically: retention
/// periods are undecided (Q-02), so a request is recorded and staff act on it; payment and audit records are never deleted.
model DeletionRequest {
  id          String                @id @default(uuid(7)) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  status      DeletionRequestStatus @default(REQUESTED)
  reason      String?
  requestedAt DateTime              @default(now()) @map("requested_at") @db.Timestamptz(6)
  cancelledAt DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  completedAt DateTime?             @map("completed_at") @db.Timestamptz(6)

  user User @relation("DeletionRequestUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@map("deletion_requests")
}

/// Generic Idempotency-Key store: one row per (user, key). The first request claims the key (IN_PROGRESS) and stores its response when
/// done; a repeat with the same key and the same request replays that response, a different request is refused. Rows lapse after
/// `expires_at` and are purged by the worker.
model IdempotencyKey {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  key          String
  method       String
  path         String
  requestHash  String   @map("request_hash")
  done         Boolean  @default(false)
  statusCode   Int?     @map("status_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// PRD section 12 "Interview/Trial: schedule, status, outcome". One row per interview or trial session of a booking (a booking can have
/// several over time, at most ONE open at a time: partial unique index in the migration). The booking keeps its coarse state
/// (matched / scheduled / completed); this entity holds the request, the worker answer, proposals, rescheduling and the outcome.
model InterviewTrial {
  id                String          @id @default(uuid(7)) @db.Uuid
  bookingId         String          @map("booking_id") @db.Uuid
  type              ScheduleType
  status            InterviewStatus @default(REQUESTED)
  requestedByKind   String          @map("requested_by_kind")
  requestedByUserId String?         @map("requested_by_user_id") @db.Uuid
  /// What the customer asked for.
  preferredAt       DateTime        @map("preferred_at") @db.Timestamptz(6)
  /// The agreed time (set when CONFIRMED).
  scheduledAt       DateTime?       @map("scheduled_at") @db.Timestamptz(6)
  /// A different time proposed by the other party, waiting for an answer.
  proposedAt        DateTime?       @map("proposed_at") @db.Timestamptz(6)
  proposedByKind    String?         @map("proposed_by_kind")
  note              String?
  declineReason     String?         @map("decline_reason")
  cancelReason      String?         @map("cancel_reason")
  outcomeNote       String?         @map("outcome_note")
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(6)
  cancelledAt       DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
  @@index([status, scheduledAt])
  @@map("interview_trials")
}

/// Typical price band shown to customers on the Budget step. Entered by an administrator (nothing is derived or invented): one row per
/// category + engagement, optionally narrowed to one area (an area row wins over the category-wide row). Amounts are paise.
model PricingGuidance {
  id         String               @id @default(uuid(7)) @db.Uuid
  categoryId String               @map("category_id") @db.Uuid
  areaId     String?              @map("area_id") @db.Uuid
  engagement EngagementPreference
  minMinor   Int                  @map("min_minor")
  maxMinor   Int                  @map("max_minor")
  /// HOUR | DAY | MONTH | ONE_TIME (the Budget step periods).
  period     String
  /// Short text shown with the band, for example "Typical for Hyderabad, set by SevaNest".
  basis      String
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  area     ServiceArea?    @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([areaId])
  @@map("pricing_guidance")
}

enum WagePaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  OTHER
}

/// DEC-05: a wage payment the platform did NOT make (V1 is not payroll). Staff record that the customer paid the worker off-platform, for the
/// worker's information. Append-only (database trigger): a mistake is fixed by a new row that `corrects` the old one (or voids it); the old row
/// stays as history. A row counts toward the worker's totals only while nothing corrects it and it is not a void.
model WorkerPaymentReference {
  id               String            @id @default(uuid(7)) @db.Uuid
  bookingId        String            @map("booking_id") @db.Uuid
  workerId         String            @map("worker_id") @db.Uuid
  amountMinor      Int               @map("amount_minor")
  currency         String            @default("INR")
  periodLabel      String            @map("period_label")
  method           WagePaymentMethod
  referenceText    String            @map("reference_text")
  /// The earlier row this one replaces (a correction) or cancels (isVoid). At most one correction per row.
  correctsId       String?           @unique @map("corrects_id") @db.Uuid
  isVoid           Boolean           @default(false) @map("is_void")
  recordedByUserId String            @map("recorded_by_user_id") @db.Uuid
  recordedAt       DateTime          @default(now()) @map("recorded_at") @db.Timestamptz(6)

  booking    Booking                 @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  worker     WorkerProfile           @relation(fields: [workerId], references: [id], onDelete: Restrict)
  recordedBy User                    @relation("WorkerPaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  corrects   WorkerPaymentReference? @relation("WorkerPaymentCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  correctedBy WorkerPaymentReference[] @relation("WorkerPaymentCorrection")

  @@index([workerId, recordedAt])
  @@index([bookingId])
  @@map("worker_payment_references")
}

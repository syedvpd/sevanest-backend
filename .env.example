# Copy to .env for local development. Never commit .env. Values below are local-dev placeholders only.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Interactive OpenAPI docs at /docs. Keep false in production unless explicitly approved.
SWAGGER_ENABLED=true

# PostgreSQL (source of truth). Matches docker-compose.yml.
POSTGRES_USER=sevanest
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sevanest
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sevanest:change-me-local-only@localhost:5432/sevanest?schema=public

# Redis (non-authoritative: throttling, cache, BullMQ). Matches docker-compose.yml.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT access tokens. Generate a long random secret per environment (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
JWT_ACCESS_SECRET=change-me-generate-a-random-secret-of-32-chars-or-more
# Lifetimes are configuration, not business policy. BEA suggests ~15 min access; confirm before production.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Global per-IP request throttle (first-line abuse protection).
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# memory = per process; use redis when more than one API instance runs
THROTTLE_STORAGE=memory

# Mobile OTP login (FRD FM-01) and admin login. The specs leave every value below OPEN (Q-12, Q-18): these are
# development placeholders, NOT approved business values. Production must set explicit, reviewed values.
# Key for the HMAC that protects stored OTP verifiers. Generate per environment, like JWT_ACCESS_SECRET.
OTP_HMAC_SECRET=local-dev-otp-hmac-key-do-not-use-0123456789
# memory = OTP kept in process memory (tests/local only, refused in production). disabled = OTP requests answer 503.
SMS_PROVIDER=disabled
# KYC documents (FR-VER, FR-SEC-004). No storage vendor is selected (Q-08) and size/type/link lifetime are open (Q-12):
# placeholders, NOT approved values. memory = tests/local only (refused in production); disabled = document endpoints answer 503.
STORAGE_PROVIDER=disabled
# s3 = S3-compatible storage (Supabase Storage). Set STORAGE_PROVIDER=s3 and fill the STORAGE_S3_* values; bucket must be private.
# STORAGE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# STORAGE_S3_REGION=<project region, e.g. ap-southeast-1>
# STORAGE_S3_BUCKET=kyc-documents
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# Payments and messaging (Q-08: no vendor selected). fake/memory = tests and local work only, refused in production.
PAYMENT_PROVIDER=disabled
# PAYMENT_FAKE_WEBHOOK_SECRET is required only when PAYMENT_PROVIDER=fake.
PUSH_PROVIDER=disabled
WHATSAPP_PROVIDER=disabled
# Top of the rating scale (FRD FM-10 "configured scale"; Q-58 open). Placeholder, NOT an approved value.
RATING_SCALE_MAX=5
VERIFICATION_DOCUMENT_MAX_BYTES=5242880
# Optional: profile photo size limit in bytes (business value, open). Unset = photo upload answers 503 PHOTO_NOT_CONFIGURED.
# PROFILE_PHOTO_MAX_BYTES=2097152
VERIFICATION_DOCUMENT_CONTENT_TYPES=application/pdf,image/jpeg,image/png
SIGNED_URL_TTL_SECONDS=120
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_SEND_WINDOW_SECONDS=3600
OTP_MAX_SENDS_PER_MOBILE_PER_WINDOW=5
OTP_MAX_REQUESTS_PER_IP_PER_WINDOW=20
OTP_LOCKOUT_SECONDS=900
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_FAILURE_WINDOW_SECONDS=900
ADMIN_LOGIN_LOCKOUT_SECONDS=900
ADMIN_PASSWORD_MIN_LENGTH=12
# Optional allow-list of customer languages, e.g. en,hi. Unset = any well-formed language code is accepted.
# SUPPORTED_LANGUAGES=

# Dedicated database for committing integration tests (name must end in _test or _ci). Never the development database.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sevanest_test?schema=public

# Development-only bootstrap of the first Super Admin, read by `npm run seed` (never committed, never hard-coded).
# BOOTSTRAP_SUPER_ADMIN_EMAIL=
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------------
# Real providers (Phase 1 production readiness). Secrets belong in the deployment secret store (Render env vars, Docker/K8s
# secrets), never in a committed file. A selected provider with missing/malformed settings stops the process at start-up.
# ---------------------------------------------------------------------------------------------------------------------

# --- SMS / OTP: SMS_PROVIDER=twilio | msg91 (memory = tests only, disabled = OTP answers 503 SMS_NOT_CONFIGURED) ---
# Timeout for every outbound SMS/WhatsApp/payment-gateway call (ms).
# PROVIDER_HTTP_TIMEOUT_MS=8000
# Twilio (also used by WHATSAPP_PROVIDER=twilio). For India use a Messaging Service with a registered sender.
# TWILIO_ACCOUNT_SID=AC................................
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=MG................................   # preferred; or TWILIO_SMS_FROM=+1415...
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886                          # only for WHATSAPP_PROVIDER=twilio
# MSG91 (India, DLT): the OTP flow template must be DLT-approved; the variable name is the one used inside it (##OTP## -> OTP).
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_OTP_VARIABLE=OTP

# --- Payments: PAYMENT_PROVIDER=razorpay (fake = tests only, disabled = payments answer 503) ---
# Use rzp_test_* keys for test mode. RAZORPAY_WEBHOOK_SECRET is the secret typed when creating the webhook in the Razorpay
# dashboard (NOT the key secret). Webhook URL: https://<api-host>/api/v1/webhooks/payments with events payment.captured,
# payment.failed, refund.processed, refund.failed. Enable AUTO-CAPTURE in the dashboard (an authorized-only payment is
# never treated as paid).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Proxy and rate limits ---
# Number of trusted reverse-proxy hops in FRONT of the API. REQUIRED in production (the API refuses to start without it).
# 0 = clients connect directly (no proxy/load balancer); 1 = one balancer (Render, a single nginx, an AWS ALB); 2 = CDN + balancer.
# Too low: every user shares the balancer's address and per-IP limits (OTP, admin login) lock everyone out together.
# Too high: a client can forge X-Forwarded-For and dodge per-IP limits. See README "Proxy and client IP" for how to check the value.
# TRUST_PROXY_HOPS=1

# --- Background jobs ---
# false (default): background loops run in the separate worker process (`node dist/worker`, a Render "Background Worker").
# true: the API process also runs them (notification delivery, payment recovery, re-check reminders). Use only when a separate
# worker service is not available; all loops claim their rows atomically, so several replicas are safe.
# EMBEDDED_WORKERS=false

# ---------------------------------------------------------------------------------------------------------------------
# Operational rules (gap closing). EVERY value below is optional: unset = the rule is OFF. The business has not decided these
# periods (Q-55, Q-59, Q-78), so none has a default.
# ---------------------------------------------------------------------------------------------------------------------
# A matched worker who has not accepted/declined within this many hours raises a BOOKING_NO_RESPONSE staff alert (nothing is reassigned).
# WORKER_RESPONSE_HOURS=
# A booking waiting in PENDING_PAYMENT this long raises a BOOKING_STUCK_PAYMENT alert / is cancelled automatically (its payment is closed
# by the normal cancellation path; a payment that already succeeded is never refunded automatically). Cancel must be greater than alert.
# PENDING_PAYMENT_ALERT_HOURS=
# PENDING_PAYMENT_AUTO_CANCEL_HOURS=
# Support resolution targets in hours (per ticket priority, falling back to the default). A breach raises a staff alert once.
# SUPPORT_SLA_HOURS_DEFAULT=
# SUPPORT_SLA_HOURS_LOW=
# SUPPORT_SLA_HOURS_MEDIUM=
# SUPPORT_SLA_HOURS_HIGH=

# --- Push (FCM HTTP v1): PUSH_PROVIDER=fcm and the Firebase service-account JSON on ONE line (a secret: environment only) ---
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}

# --- Worker profile photo: unset = photo upload answers 503 PHOTO_NOT_CONFIGURED. The size limit is a business value (FRD FM-04). ---
# PROFILE_PHOTO_MAX_BYTES=

# --- Legal documents (versions come from the reviewed text; unset = no consent is asked or enforced) ---
# LEGAL_TERMS_VERSION=2026-10
# LEGAL_PRIVACY_VERSION=2026-10
# LEGAL_TERMS_URL=https://example.com/terms
# LEGAL_PRIVACY_URL=https://example.com/privacy
# true = creating a booking requires the current terms and privacy versions to be accepted (403 LEGAL_ACCEPTANCE_REQUIRED).
# LEGAL_ACCEPTANCE_REQUIRED=false

# --- App start-up policy returned by GET /api/v1/app-config (no sign-in needed) ---
# APP_MIN_VERSION_CUSTOMER=1.0.0
# APP_MIN_VERSION_WORKER=1.0.0
# APP_MAINTENANCE_MODE=false
# SUPPORT_CONTACT_PHONE=
# SUPPORT_CONTACT_EMAIL=

# --- STAGING/DEMO ONLY: log in without SMS ---
# The numbers below log in with the fixed code and NO SMS is sent; every other number is unaffected (still 503 while SMS is disabled).
# Cooldown, attempt limit, lockout and expiry still apply. There is deliberately no default code. Never enable for real users.
# ALLOW_TEST_OTP=true
# TEST_OTP_NUMBERS=+919999900001,+919999900002
# TEST_OTP_CODE=123456

# Copy to .env for local development. Never commit .env. Values below are local-dev placeholders only.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Interactive OpenAPI docs at /docs. Keep false in production unless explicitly approved.
SWAGGER_ENABLED=true

# PostgreSQL (source of truth). Matches docker-compose.yml.
POSTGRES_USER=sevanest
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sevanest
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sevanest:change-me-local-only@localhost:5432/sevanest?schema=public

# Redis (non-authoritative: throttling, cache, BullMQ). Matches docker-compose.yml.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT access tokens. Generate a long random secret per environment (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
JWT_ACCESS_SECRET=change-me-generate-a-random-secret-of-32-chars-or-more
# Lifetimes are configuration, not business policy. BEA suggests ~15 min access; confirm before production.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Global per-IP request throttle (first-line abuse protection).
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
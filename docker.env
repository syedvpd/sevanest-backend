# LOCAL DOCKER ONLY - safe, non-secret development values so `docker compose --profile app up -d --build` works right after `git clone`.
# Nothing here is a real credential. Never reuse these values anywhere that holds real data. Production uses its own environment.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=true
JWT_ACCESS_SECRET=local-docker-jwt-secret-not-for-production-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_HMAC_SECRET=local-docker-otp-hmac-key-not-for-production-0123456789
THROTTLE_STORAGE=memory
THROTTLE_LIMIT=1000
SMS_PROVIDER=disabled
STORAGE_PROVIDER=disabled
PAYMENT_PROVIDER=fake
PAYMENT_FAKE_WEBHOOK_SECRET=local-docker-fake-webhook-secret-0123456789
PUSH_PROVIDER=disabled
WHATSAPP_PROVIDER=disabled
RATING_SCALE_MAX=5
TRUST_PROXY_HOPS=0
# Demo logins without an SMS provider: these demo numbers accept the fixed code below (development only; refused in production).
ALLOW_TEST_OTP=true
TEST_OTP_NUMBERS=+919000000101,+919000000102,+919000000103,+919000000201,+919000000202,+919000000203
TEST_OTP_CODE=123456
# Development Super Admin created by the seed (local only).
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@sevanest.local
BOOTSTRAP_SUPER_ADMIN_PASSWORD=Local-Docker-Admin-2026!
# Remaining tunables copied from .env.example
THROTTLE_TTL_SECONDS=60
VERIFICATION_DOCUMENT_MAX_BYTES=5242880
VERIFICATION_DOCUMENT_CONTENT_TYPES=application/pdf,image/jpeg,image/png
SIGNED_URL_TTL_SECONDS=120
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_SEND_WINDOW_SECONDS=3600
OTP_MAX_SENDS_PER_MOBILE_PER_WINDOW=5
OTP_MAX_REQUESTS_PER_IP_PER_WINDOW=20
OTP_LOCKOUT_SECONDS=900
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_FAILURE_WINDOW_SECONDS=900
ADMIN_LOGIN_LOCKOUT_SECONDS=900
ADMIN_PASSWORD_MIN_LENGTH=12

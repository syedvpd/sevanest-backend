# Template for the local Docker stack. Copy to docker.env (git-ignored) and set your own values:
#   cp docker.env.example docker.env
# Every change-me value MUST be replaced. Never reuse these values, or your docker.env values, on a shared environment.
# LOCAL DOCKER ONLY (`docker compose --profile app up -d --build`). Production and staging use their own environment variables.
# Generate secrets with e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"` (one per secret).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=true
JWT_ACCESS_SECRET=change-me-generate-a-random-secret-of-32-chars-or-more
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_HMAC_SECRET=change-me-generate-a-different-random-secret-of-32-chars
THROTTLE_STORAGE=memory
THROTTLE_LIMIT=1000
SMS_PROVIDER=disabled
STORAGE_PROVIDER=disabled
PAYMENT_PROVIDER=fake
PAYMENT_FAKE_WEBHOOK_SECRET=change-me-fake-webhook-secret-16-chars-min
PUSH_PROVIDER=disabled
WHATSAPP_PROVIDER=disabled
RATING_SCALE_MAX=5
TRUST_PROXY_HOPS=0
# Demo logins without an SMS provider: these demo numbers accept the fixed code below (development only; refused in production).
ALLOW_TEST_OTP=true
TEST_OTP_NUMBERS=+910000000000
TEST_OTP_CODE=000000
# Development Super Admin created by the seed (local only).
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-me-use-a-long-unique-password
# Remaining tunables copied from .env.example
THROTTLE_TTL_SECONDS=60
VERIFICATION_DOCUMENT_MAX_BYTES=5242880
VERIFICATION_DOCUMENT_CONTENT_TYPES=application/pdf,image/jpeg,image/png
SIGNED_URL_TTL_SECONDS=120
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_SEND_WINDOW_SECONDS=3600
OTP_MAX_SENDS_PER_MOBILE_PER_WINDOW=5
OTP_MAX_REQUESTS_PER_IP_PER_WINDOW=20
OTP_LOCKOUT_SECONDS=900
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_FAILURE_WINDOW_SECONDS=900
ADMIN_LOGIN_LOCKOUT_SECONDS=900
ADMIN_PASSWORD_MIN_LENGTH=12
